# Environment Configuration - Automated Blockchain Intelligence & VASP Attribution Engine
# PHASE 2: Real Ethereum Blockchain Integration
# Without any API key set, the system automatically runs in DEMO mode (synthetic data).

# Application Settings
APP_NAME="Automated Blockchain Intelligence & VASP Attribution Engine"
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Database Configuration (SQLite for MVP)
DATABASE_URL="sqlite:///./backend/vasp_intelligence.db"

# ─── Phase 2: Real Ethereum Blockchain Provider (set ONE of the following) ────
# Obtain a free key at: https://etherscan.io/myapikey
# ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Alternative: Alchemy   https://dashboard.alchemy.com/
# ALCHEMY_API_KEY=your_alchemy_api_key_here

# Alternative: Infura    https://app.infura.io/
# INFURA_PROJECT_ID=your_infura_project_id_here

# ─── Blockchain Provider Tuning (optional) ────────────────────────────────────
# ETHERSCAN_BASE_URL=https://api.etherscan.io/api
# BLOCKCHAIN_REQUEST_TIMEOUT=15
# BLOCKCHAIN_CACHE_TTL=300
# BLOCKCHAIN_MAX_TX_PER_REQUEST=50

# ─── Future Chains (Phase 3+) ─────────────────────────────────────────────────
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# SAHYOG_PORTAL_CLIENT_ID=placeholder_for_future_sahyog_phase
# SAHYOG_PORTAL_SECRET=placeholder_for_future_sahyog_phase
